#!/usr/bin/env bash
#
# emoji-picker: A universal emoji + math + unicode symbol picker using dmenu.
# - Downloads latest emoji and Unicode symbol lists automatically.
# - Lets you search and copy characters to clipboard.
# - Works offline after first run.
#

# ===================================
# CONFIGURATION
# ===================================
EMOJI_DIR="$HOME/.local/share/emoji"
COMBINED_FILE="$EMOJI_DIR/combined.txt"

# Sources
EMOJI_SOURCE="https://raw.githubusercontent.com/github/gemoji/master/db/emoji.json"
UNICODE_SOURCE="https://www.unicode.org/Public/UCD/latest/ucd/UnicodeData.txt"

# Required packages
REQUIRED_PKGS=(dmenu xclip curl jq)

# ===================================
# FUNCTIONS
# ===================================

check_dependencies() {
  for pkg in "${REQUIRED_PKGS[@]}"; do
    if ! command -v "$pkg" >/dev/null 2>&1; then
      echo "Installing missing package: $pkg"
      sudo pacman -S --noconfirm "$pkg"
    fi
  done
}

download_emoji_list() {
  echo "Downloading latest emoji list..."
  curl -s "$EMOJI_SOURCE" | jq -r '.[] | "\(.emoji)  \(.description)"' >"$EMOJI_DIR/emoji.txt"
}

download_unicode_symbols() {
  echo "Downloading latest Unicode symbols..."
  curl -s "$UNICODE_SOURCE" | awk -F';' '
        {
            code = $1
            name = $2

            # Skip control and private use characters
            if (name ~ /<control>/ || name ~ /PRIVATE USE/) next

            # Convert codepoint to zero-padded 8-digit hex
            # Example: "2192" -> "00002192"
            hex = sprintf("%08X", strtonum("0x" code))

            # Build printf command to render the actual character
            cmd = "printf \"\\\\U" hex "\""
            cmd | getline char
            close(cmd)

            # Include only specific categories to keep list manageable
            if (name ~ /(ARROW|MATH|OPERATOR|INTEGRAL|SUMMATION|SIGN|NUMBER|FRACTION|ANGLE|DIVISION|MULTIPLICATION|EQUAL|GREEK|CURRENCY|LOGICAL)/) {
                printf("%s  %s\n", char, name)
            }
        }
    ' >"$EMOJI_DIR/unicode.txt"
}

combine_lists() {
  echo "Combining emoji and Unicode lists..."
  cat "$EMOJI_DIR/emoji.txt" "$EMOJI_DIR/unicode.txt" | sort -u >"$COMBINED_FILE"
}

update_all() {
  mkdir -p "$EMOJI_DIR"
  download_emoji_list
  download_unicode_symbols
  combine_lists
  echo "Updated combined list at $COMBINED_FILE"
}

show_picker() {
  if [[ ! -f "$COMBINED_FILE" ]]; then
    echo "No data found. Downloading..."
    update_all
  fi

  chosen=$(cat "$COMBINED_FILE" | dmenu -i -l 15 -p "Search:" -fn "Monospace 12, Noto Color Emoji 12")

  [[ -z "$chosen" ]] && exit 0

  # Extract only the character (first field)
  symbol=$(echo "$chosen" | awk '{print $1}')

  # Copy to clipboard
  echo -n "$symbol" | xclip -selection clipboard

  # Notify user
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Copied to clipboard" "$symbol"
  fi
}

# ===================================
# MAIN
# ===================================
mkdir -p "$EMOJI_DIR"
check_dependencies

case "$1" in
--update)
  update_all
  ;;
*)
  show_picker
  ;;
esac
